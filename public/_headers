# Cloudflare's default for all other files is:
# public, max-age=0, must-revalidate (HTML, RSC .txt, search JSON, fixed-name files).
# Do not add an overlapping /* Cache-Control rule: matching values are combined.
# Direct children of /assets/ are fingerprinted build output; fixed-name public
# resources must stay outside this directory.
/assets/:file
  Cache-Control: public, max-age=31536000, immutable

/docs/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/docs/content-assets/*
  Cache-Control: public, max-age=31536000, immutable
